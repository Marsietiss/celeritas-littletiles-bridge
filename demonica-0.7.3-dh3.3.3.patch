@@ -0,0 +1,22 @@
+package com.demonica.mixin.mod.littletiles;
+
+import com.llamalad7.mixinextras.injector.ModifyExpressionValue;
+import org.spongepowered.asm.mixin.Mixin;
+import org.spongepowered.asm.mixin.Pseudo;
+import org.spongepowered.asm.mixin.injection.At;
+
+
+import java.nio.ByteBuffer;
+
+@Pseudo
+@Mixin(targets = "com.creativemd.littletiles.client.render.cache.LayeredRenderBufferCache", remap = false)
+public abstract class LayeredRenderBufferCacheMixin {
+    // Transition caches can share IRenderDataCache objects. Keep combine() from
+    // changing cursors used concurrently by another cache or a bridge snapshot.
+    @ModifyExpressionValue(method = "combine", at = @At(value = "INVOKE",
+            target = "Lcom/creativemd/littletiles/client/render/cache/IRenderDataCache;byteBuffer()Ljava/nio/ByteBuffer;"),
+            remap = false, require = 2)
+    private ByteBuffer independentSourceCursor(ByteBuffer source) {
+        return source == null ? null : source.duplicate().order(source.order());
+    }
+}
