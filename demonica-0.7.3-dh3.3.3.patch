@@ -0,0 +1,76 @@
+package com.demonica.mixin.mod.distanthorizons;
+
+import com.seibel.distanthorizons.core.wrapperInterfaces.modAccessor.IIrisAccessor;
+import com.seibel.distanthorizons.core.wrapperInterfaces.modAccessor.IModAccessor;
+import org.junit.jupiter.api.BeforeEach;
+import org.junit.jupiter.api.Test;
+import org.spongepowered.asm.mixin.injection.callback.CallbackInfo;
+
+import java.lang.reflect.Field;
+import java.lang.reflect.Method;
+import java.util.ArrayList;
+import java.util.List;
+import java.util.function.Supplier;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+
+class MixinAbstractModInitializerTest {
+    private final Initializer initializer = new Initializer();
+
+    @BeforeEach
+    void resetBindingGuard() throws Exception {
+        Field field = MixinAbstractModInitializer.class.getDeclaredField("demonica$irisAccessorBound");
+        field.setAccessible(true);
+        field.setBoolean(null, false);
+    }
+
+    @Test
+    void rewritesReleasedDh333ProviderAndDoesNotDoubleBindFutureProvider() {
+        initializer.call("actinium", IIrisAccessor.class);
+        initializer.call("demonica", IIrisAccessor.class);
+        assertEquals(List.of("demonica"), initializer.boundIds);
+    }
+
+    @Test
+    void acceptsArrayProviderWithoutDoubleBinding() throws Exception {
+        Method method = MixinAbstractModInitializer.class.getDeclaredMethod("demonica$bindIrisAccessorOnceFromArray",
+            String[].class, Class.class, Supplier.class, CallbackInfo.class);
+        method.setAccessible(true);
+        method.invoke(initializer, new String[] { "actinium", "demonica" }, IIrisAccessor.class,
+            (Supplier<IIrisAccessor>) () -> null, new CallbackInfo("test", true));
+        initializer.call("demonica", IIrisAccessor.class);
+        assertEquals(List.of("demonica"), initializer.boundIds);
+    }
+
+    @Test
+    void leavesOtherCompatibilityAccessorsAlone() {
+        initializer.call("other-provider", IModAccessor.class);
+        initializer.call("actinium", IIrisAccessor.class);
+        assertEquals(List.of("other-provider", "demonica"), initializer.boundIds);
+    }
+
+    private static class Initializer extends MixinAbstractModInitializer {
+        final List<String> boundIds = new ArrayList<>();
+
+        void call(String id, Class<?> accessorClass) {
+            try {
+                Method method = MixinAbstractModInitializer.class.getDeclaredMethod("demonica$bindIrisAccessorOnce",
+                    String.class, Class.class, Supplier.class, CallbackInfo.class);
+                method.setAccessible(true);
+                CallbackInfo callback = new CallbackInfo("test", true);
+                method.invoke(this, id, accessorClass, (Supplier<IModAccessor>) () -> null, callback);
+                if (!callback.isCancelled()) boundIds.add(id);
+            } catch (ReflectiveOperationException e) {
+                throw new AssertionError(e);
+            }
+        }
+
+        @Override
+        protected <T extends IModAccessor> void tryCreateModCompatAccessor(
+            String id, Class<? super T> accessorClass, Supplier<T> constructor
+        ) {
+            // Model the real superclass method's re-entry through the injected HEAD callback.
+            call(id, accessorClass);
+        }
+    }
+}
