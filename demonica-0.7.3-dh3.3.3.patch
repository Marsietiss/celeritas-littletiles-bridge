@@ -0,0 +1,30 @@
+package com.demonica.mixins;
+
+import org.junit.jupiter.api.Test;
+import org.objectweb.asm.ClassReader;
+import org.objectweb.asm.Opcodes;
+import org.objectweb.asm.tree.ClassNode;
+
+import java.io.InputStream;
+import java.util.Set;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertNotEquals;
+import static org.junit.jupiter.api.Assertions.assertNotNull;
+
+class LittleTilesMixinPluginTest {
+    @Test
+    void completesActualLittleTilesCacheMonitorProtocol() throws Exception {
+        String name = "com.creativemd.littletiles.client.render.cache.LayeredRenderBufferCache";
+        try (InputStream stream = getClass().getClassLoader().getResourceAsStream(name.replace('.', '/') + ".class")) {
+            assertNotNull(stream);
+            ClassNode node = new ClassNode();
+            new ClassReader(stream).accept(node, 0);
+            new LittleTilesMixinPlugin().preApply(name, node, "test", null);
+            Set<String> patched = Set.of("get", "hasAdditional", "beforeUpdate", "afterUpdate");
+            assertEquals(4, node.methods.stream().filter(method -> patched.contains(method.name)).count());
+            node.methods.stream().filter(method -> patched.contains(method.name))
+                .forEach(method -> assertNotEquals(0, method.access & Opcodes.ACC_SYNCHRONIZED, method.name));
+        }
+    }
+}
