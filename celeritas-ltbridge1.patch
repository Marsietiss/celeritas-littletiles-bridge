@@ -0,0 +1,21 @@
+package org.taumc.celeritas.impl.compat.littletiles.mixin;
+
+import net.minecraft.client.renderer.ViewFrustum;
+import net.minecraft.client.renderer.chunk.RenderChunk;
+import net.minecraft.util.math.BlockPos;
+import org.spongepowered.asm.mixin.Mixin;
+import org.spongepowered.asm.mixin.Pseudo;
+import org.spongepowered.asm.mixin.injection.At;
+import org.spongepowered.asm.mixin.injection.Inject;
+import org.spongepowered.asm.mixin.injection.callback.CallbackInfoReturnable;
+import org.taumc.celeritas.impl.compat.littletiles.LittleTilesCompat;
+
+@Pseudo
+@Mixin(targets = "com.creativemd.littletiles.client.render.world.RenderUtils", remap = false)
+public abstract class RenderUtilsMixin {
+    @Inject(method = "getRenderChunk(Lnet/minecraft/client/renderer/ViewFrustum;Lnet/minecraft/util/math/BlockPos;)Lnet/minecraft/client/renderer/chunk/RenderChunk;",
+            at = @At("HEAD"), cancellable = true, remap = false)
+    private static void bridgeChunk(ViewFrustum frustum, BlockPos pos, CallbackInfoReturnable<RenderChunk> cir) {
+        cir.setReturnValue(LittleTilesCompat.getRenderChunk(pos));
+    }
+}
