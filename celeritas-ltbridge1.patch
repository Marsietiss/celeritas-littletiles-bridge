@@ -0,0 +1,22 @@
+package org.taumc.celeritas.impl.compat.littletiles;
+
+import java.nio.ByteBuffer;
+import java.nio.ByteOrder;
+
+/** Copies a published LittleTiles cache without changing the shared buffer's cursor. */
+public final class LittleTilesBufferCopy {
+    private LittleTilesBufferCopy() {}
+
+    public static int[] snapshot(ByteBuffer source, int length, int stride) {
+        if (length < 0 || stride <= 0 || stride % 4 != 0 || length % (stride * 4) != 0
+                || length > source.limit()) {
+            throw new IllegalArgumentException("Invalid LittleTiles quad buffer: " + length);
+        }
+        ByteBuffer copy = source.duplicate().order(ByteOrder.nativeOrder());
+        copy.position(0);
+        copy.limit(length);
+        int[] data = new int[length / 4];
+        copy.asIntBuffer().get(data);
+        return data;
+    }
+}
diff --git a/forge122/src/main/java/org/taumc/celeritas/impl/compat/littletiles/LittleTilesCompat.java b/forge122/src/main/java/org/taumc/celeritas/impl/compat/littletiles/LittleTilesCompat.java
