+++ b/forge122/src/main/java/org/taumc/celeritas/impl/compat/littletiles/LittleTilesCompat.java
@@ -0,0 +1,200 @@
+package org.taumc.celeritas.impl.compat.littletiles;
+
+import net.minecraft.client.Minecraft;
+import net.minecraft.client.renderer.BufferBuilder;
+import net.minecraft.client.renderer.chunk.RenderChunk;
+import net.minecraft.client.renderer.vertex.DefaultVertexFormats;
+import net.minecraft.tileentity.TileEntity;
+import net.minecraft.util.BlockRenderLayer;
+import net.minecraft.util.math.BlockPos;
+import net.minecraft.world.World;
+import net.minecraftforge.common.MinecraftForge;
+import net.minecraftforge.event.world.WorldEvent;
+import net.minecraftforge.event.world.ChunkEvent;
+import net.minecraftforge.fml.common.Loader;
+import net.minecraftforge.fml.common.eventhandler.SubscribeEvent;
+import org.taumc.celeritas.CeleritasVintage;
+
+import java.lang.reflect.Field;
+import java.lang.reflect.Method;
+import java.nio.ByteBuffer;
+import java.util.Set;
+import java.util.concurrent.ConcurrentHashMap;
+
+/** Bridge between LittleTiles' asynchronous mesh cache and Celeritas' chunk builder. */
+public final class LittleTilesCompat {
+    private static volatile boolean initialized;
+    private static volatile boolean available;
+    private static volatile World activeWorld;
+    private static Class<?> tileClass;
+    private static Field renderField;
+    private static Method chunkUpdate, getBufferCache, cacheGet, dataBuffer, dataLength;
+    private static final ConcurrentHashMap<BlockPos, BridgeRenderChunk> CHUNKS = new ConcurrentHashMap<>();
+    private static final Set<TileEntity> REQUESTS = ConcurrentHashMap.newKeySet();
+    private static boolean loggedFailure;
+
+    private LittleTilesCompat() {}
+
+    public static synchronized void initialize() {
+        if (initialized) return;
+        initialized = true;
+        if (!Loader.isModLoaded("littletiles")) return;
+        try {
+            ClassLoader loader = LittleTilesCompat.class.getClassLoader();
+            tileClass = Class.forName("com.creativemd.littletiles.common.tileentity.TileEntityLittleTiles", false, loader);
+            Class<?> manager = Class.forName("com.creativemd.littletiles.client.render.world.TileEntityRenderManager", false, loader);
+            Class<?> cache = Class.forName("com.creativemd.littletiles.client.render.cache.LayeredRenderBufferCache", false, loader);
+            Class<?> data = Class.forName("com.creativemd.littletiles.client.render.cache.IRenderDataCache", false, loader);
+            renderField = tileClass.getField("render");
+            chunkUpdate = manager.getMethod("chunkUpdate", Object.class);
+            getBufferCache = manager.getMethod("getBufferCache");
+            cacheGet = cache.getMethod("get", int.class);
+            dataBuffer = data.getMethod("byteBuffer");
+            dataLength = data.getMethod("length");
+            available = true;
+            MinecraftForge.EVENT_BUS.register(new WorldCleanup());
+            CeleritasVintage.logger().info("Experimental LittleTiles mesh bridge enabled (lt-bridge-1)");
+        } catch (ReflectiveOperationException e) {
+            throw new IllegalStateException("Unsupported LittleTiles API for the experimental Celeritas bridge", e);
+        }
+    }
+
+    public static boolean isLittleTile(TileEntity tile) {
+        return available && tileClass.isInstance(tile);
+    }
+
+    public static void requestCache(TileEntity tile) {
+        if (!REQUESTS.add(tile)) return;
+        Minecraft mc = Minecraft.getMinecraft();
+        mc.addScheduledTask(() -> {
+            try {
+                if (tile.isInvalid() || tile.getWorld() != mc.world) return;
+                Object manager = renderField.get(tile);
+                if (manager != null) chunkUpdate.invoke(manager, (Object) null);
+            } catch (ReflectiveOperationException e) {
+                reportFailure(e);
+            } finally {
+                REQUESTS.remove(tile);
+            }
+        });
+    }
+
+    public static void append(TileEntity tile, BlockRenderLayer layer, BufferBuilder destination) {
+        try {
+            Object manager = renderField.get(tile);
+            if (manager == null) return;
+            int[] vertices;
+            synchronized (manager) {
+                Object cache = getBufferCache.invoke(manager);
+                Object data = cacheGet.invoke(cache, layer.ordinal());
+                if (data == null) return;
+                ByteBuffer source = (ByteBuffer) dataBuffer.invoke(data);
+                int length = (Integer) dataLength.invoke(data);
+                if (source == null || length == 0) return;
+                vertices = LittleTilesBufferCopy.snapshot(source, length, DefaultVertexFormats.BLOCK.getSize());
+            }
+            // LittleTiles already stores positions relative to this 16-block section.
+            destination.addVertexData(vertices);
+        } catch (ReflectiveOperationException | IllegalArgumentException e) {
+            reportFailure(e);
+        }
+    }
+
+    private static synchronized void reportFailure(Exception e) {
+        if (!loggedFailure) {
+            loggedFailure = true;
+            CeleritasVintage.logger().error("LittleTiles bridge could not copy or rebuild a mesh", e);
+        }
+    }
+
+    /** Called by LittleTiles instead of looking for a vanilla ViewFrustum. */
+    public static RenderChunk getRenderChunk(BlockPos pos) {
+        Minecraft mc = Minecraft.getMinecraft();
+        World world = mc.world;
+        if (world == null) return null;
+        BlockPos origin = new BlockPos(pos.getX() & ~15, pos.getY() & ~15, pos.getZ() & ~15);
+        if (activeWorld == world) {
+            BridgeRenderChunk existing = CHUNKS.get(origin);
+            if (existing != null) return existing;
+        }
+        if (!mc.isCallingFromMinecraftThread()) {
+            mc.addScheduledTask(() -> {
+                if (mc.world == world) {
+                    getRenderChunk(origin);
+                    markDirty(world, origin);
+                }
+            });
+            return null;
+        }
+        if (activeWorld != world) {
+            clearChunks();
+            activeWorld = world;
+        }
+        if (!world.isBlockLoaded(origin)) return null;
+        return CHUNKS.computeIfAbsent(origin, key -> new BridgeRenderChunk(world, key));
+    }
+
+    private static void markDirty(World world, BlockPos origin) {
+        Minecraft mc = Minecraft.getMinecraft();
+        mc.addScheduledTask(() -> {
+            if (mc.world == world && mc.renderGlobal != null && world.isBlockLoaded(origin)) {
+                mc.renderGlobal.markBlockRangeForRenderUpdate(origin.getX(), origin.getY(), origin.getZ(),
+                        origin.getX() + 15, origin.getY() + 15, origin.getZ() + 15);
+            }
+        });
+    }
+
+    private static void clearChunks() {
+        // RenderChunk allocates GL buffers in its constructor; both allocation and disposal stay on the client thread.
+        CHUNKS.values().forEach(RenderChunk::deleteGlResources);
+        CHUNKS.clear();
+        REQUESTS.clear();
+        activeWorld = null;
+    }
+
+    public static final class WorldCleanup {
+        @SubscribeEvent
+        public void onChunkUnload(ChunkEvent.Unload event) {
+            World unloaded = event.getWorld();
+            int x = event.getChunk().x << 4;
+            int z = event.getChunk().z << 4;
+            if (unloaded.isRemote) Minecraft.getMinecraft().addScheduledTask(() -> {
+                if (activeWorld != unloaded) return;
+                CHUNKS.forEach((origin, chunk) -> {
+                    if (origin.getX() == x && origin.getZ() == z && CHUNKS.remove(origin, chunk)) {
+                        chunk.deleteGlResources();
+                    }
+                });
+            });
+        }
+
+        @SubscribeEvent
+        public void onUnload(WorldEvent.Unload event) {
+            World unloaded = event.getWorld();
+            if (unloaded.isRemote) Minecraft.getMinecraft().addScheduledTask(() -> {
+                if (activeWorld == unloaded) clearChunks();
+            });
+        }
+    }
+
+    /** Supplies the position/lock expected by LittleTiles, forwarding mesh completion to Celeritas. */
+    public static final class BridgeRenderChunk extends RenderChunk {
+        private final World bridgeWorld;
+
+        BridgeRenderChunk(World world, BlockPos origin) {
+            super(world, Minecraft.getMinecraft().renderGlobal, 0);
+            this.bridgeWorld = world;
+            setPosition(origin.getX(), origin.getY(), origin.getZ());
+        }
+
+        @Override
+        public void setNeedsUpdate(boolean immediate) {
+            if (bridgeWorld != null) markDirty(bridgeWorld, getPosition());
+        }
+
+        @Override
+        public boolean needsUpdate() {
+            return false;
+        }
+    }
+}
